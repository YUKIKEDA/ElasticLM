<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ElasticLM.Client\ElasticLM.Client.csproj" />
    <!-- The server-side proof verifier checks what the client builds. -->
    <ProjectReference Include="..\..\src\ElasticLM.Issuing\ElasticLM.Issuing.csproj" />
    <!-- design §12.6.2: the activation tests run against a real elm-service on loopback, started by the service tests' helper. -->
    <ProjectReference Include="..\..\src\ElasticLM.Service\ElasticLM.Service.csproj" />
    <Compile Include="..\ElasticLM.Service.Tests\TestService.cs" Link="TestService.cs" />
    <!-- design §20.7, V1c2c: the public types and members are compared with the .NET API reference page. -->
    <Compile Include="..\ElasticLM.Licensing.Tests\ReferencePages.cs" Link="ReferencePages.cs" />
    <!-- design §20.7, V1c6: the XML documentation file of ElasticLM.Client is searched for internal identifiers. -->
    <Compile Include="..\ElasticLM.Licensing.Tests\InternalReferences.cs" Link="InternalReferences.cs" />
    <!-- design §20.7, V1d14: the forms of a token without a signature, shared by the tests of every verifier. -->
    <Compile Include="..\ElasticLM.Licensing.Tests\SignatureForms.cs" Link="SignatureForms.cs" />
  </ItemGroup>
</Project>
