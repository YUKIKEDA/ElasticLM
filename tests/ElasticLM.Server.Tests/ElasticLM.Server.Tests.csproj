<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup>
    <!-- The server runs in the test process on a loopback port; the client is the real ElasticLM.Client. -->
    <ProjectReference Include="..\..\src\ElasticLM.Server\ElasticLM.Server.csproj" />
    <ProjectReference Include="..\..\src\ElasticLM.Issuing\ElasticLM.Issuing.csproj" />
    <ProjectReference Include="..\..\src\ElasticLM.Cli\ElasticLM.Cli.csproj" />
    <!-- design §13.7: the server license is activated against a real elm-service (M4c3). -->
    <ProjectReference Include="..\..\src\ElasticLM.Service\ElasticLM.Service.csproj" />
    <Compile Include="..\ElasticLM.Service.Tests\TestService.cs" Link="TestService.cs" />
    <!-- design §12.7.5, V1d5: the relay that replays genuine lease answers, shared with the service's tests. -->
    <Compile Include="..\ElasticLM.Service.Tests\Recorder.cs" Link="Recorder.cs" />
    <!-- design §12.6.2, V1d5a: the relay on a loopback port that replays genuine refresh answers to the server's own client. -->
    <Compile Include="..\ElasticLM.Native.Tests\ReplayingRelay.cs" Link="ReplayingRelay.cs" />
    <!-- design §20.7, V1c2: the reference pages are compared with the code. -->
    <Compile Include="..\ElasticLM.Licensing.Tests\ReferencePages.cs" Link="ReferencePages.cs" />
    <Compile Include="..\ElasticLM.Service.Tests\SettingsReference.cs" Link="SettingsReference.cs" />
    <Compile Include="..\ElasticLM.Service.Tests\EndpointRoutes.cs" Link="EndpointRoutes.cs" />
    <!-- design §20.7, V1d14: the forms of a token without a signature, shared by the tests of every verifier. -->
    <Compile Include="..\ElasticLM.Licensing.Tests\SignatureForms.cs" Link="SignatureForms.cs" />
  </ItemGroup>
</Project>
