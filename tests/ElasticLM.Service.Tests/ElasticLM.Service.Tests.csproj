<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup>
    <!-- The service runs in the test process on a loopback port, on SQLite and, when ELM_TEST_POSTGRES is set, on PostgreSQL. -->
    <ProjectReference Include="..\..\src\ElasticLM.Service\ElasticLM.Service.csproj" />
    <ProjectReference Include="..\..\src\ElasticLM.Client\ElasticLM.Client.csproj" />
    <!-- design §20.7, V1c2: the reference pages are compared with the code. -->
    <Compile Include="..\ElasticLM.Licensing.Tests\ReferencePages.cs" Link="ReferencePages.cs" />
    <!-- design §13.5, V1c12: the certificate chain whose intermediate the service must send, shared with the server's tests. -->
    <Compile Include="..\ElasticLM.Server.Tests\TestCertificateChain.cs" Link="TestCertificateChain.cs" />
    <!-- design §20.7, V1c16: the reason of a refused sign-in is read from the service's log, as the server's tests read theirs. -->
    <Compile Include="..\ElasticLM.Server.Tests\RecordingLoggerProvider.cs" Link="RecordingLoggerProvider.cs" />
    <!-- design §20.7, V1d14: the forms of a token without a signature, shared by the tests of every verifier. -->
    <Compile Include="..\ElasticLM.Licensing.Tests\SignatureForms.cs" Link="SignatureForms.cs" />
  </ItemGroup>
</Project>
