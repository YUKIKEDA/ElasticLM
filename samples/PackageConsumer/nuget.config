<?xml version="1.0" encoding="utf-8"?>
<!-- design §20.5: ElasticLM.* comes only from the packages this run made, never from nuget.org, so a package of the same
     name and version on nuget.org cannot take its place. Everything else comes from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="ElasticLM.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
