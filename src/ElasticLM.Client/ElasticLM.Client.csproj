<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>ElasticLM.Client</PackageId>
    <Description>ElasticLM client: installation keys, request proofs, and leases from on-premises servers and the hosted service. NativeAOT compatible.</Description>
    <PackageTags>licensing;license;floating;lease;nativeaot</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ElasticLM.Licensing\ElasticLM.Licensing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ElasticLM.Client.Tests" />
    <!-- The end-to-end tests lose an answer on purpose through LicenseClientOptions.WrapHandler. -->
    <InternalsVisibleTo Include="ElasticLM.Server.Tests" />
    <!-- The offline request tests (service and elm) sign request files with an installation key until M4c2 makes them in the client. -->
    <InternalsVisibleTo Include="ElasticLM.Service.Tests" />
    <InternalsVisibleTo Include="ElasticLM.Cli.Tests" />
    <!-- elm-server keeps its installation key in the same store and signs leases and its TLS certificate with it. -->
    <InternalsVisibleTo Include="elm-server" />
    <!-- elm server reads the server's administrator token with the same protection. -->
    <InternalsVisibleTo Include="elm" />
  </ItemGroup>
</Project>
