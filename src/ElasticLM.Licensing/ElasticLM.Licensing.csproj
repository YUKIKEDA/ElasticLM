<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>ElasticLM.Licensing</PackageId>
    <Description>Offline verification of ElasticLM license files: signed tokens, trust store, clock guard, and machine fingerprints. NativeAOT compatible, no dependencies.</Description>
    <PackageTags>licensing;license;verification;nativeaot</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- design §20.5: the package checks its API against a baseline once a version is published (V1e). -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ElasticLM.Licensing.Tests" />
    <!-- The issuing side signs the same payload types and applies the same rules (docs/conventions.md). -->
    <InternalsVisibleTo Include="ElasticLM.Issuing" />
    <!-- The lease engine reads feature version ranges and encodes IDs with the same code as the verifier. -->
    <InternalsVisibleTo Include="ElasticLM.Leasing" />
    <!-- The client checks the version it asked for against the server license's feature range with the verifier's own
         parser (design §12.7.5 step 7, V1d18); the two packages ship with the same version. -->
    <InternalsVisibleTo Include="ElasticLM.Client" />
    <InternalsVisibleTo Include="ElasticLM.Issuing.Tests" />
    <!-- The C ABI tests make licenses with the same test issuer (tests/ElasticLM.Licensing.Tests/TestIssuer.cs). -->
    <InternalsVisibleTo Include="ElasticLM.Native.Tests" />
    <!-- elm, elm-server, elm-service, and libelasticlm show argument messages without the .NET parameter name
         (ArgumentMessages, design §17.3 V1c10); libelasticlm's assembly name differs by OS (design §17.4). -->
    <InternalsVisibleTo Include="elm" />
    <InternalsVisibleTo Include="elm-server" />
    <InternalsVisibleTo Include="elm-service" />
    <InternalsVisibleTo Include="elasticlm" />
    <InternalsVisibleTo Include="libelasticlm" />
  </ItemGroup>
</Project>
