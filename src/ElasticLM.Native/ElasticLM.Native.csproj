<Project Sdk="Microsoft.NET.Sdk">
  <!-- libelasticlm: the C ABI over ElasticLM.Licensing and ElasticLM.Client, published as a NativeAOT shared library
       (design §17, decision 0.105). NativeAOT names the file after the assembly, so the name differs by OS:
       elasticlm.dll, libelasticlm.so, libelasticlm.dylib. The runtime identifier decides when there is one, so a
       publish for another OS gets that OS's name (design §20.5); without one, the OS of the machine decides. -->
  <PropertyGroup>
    <AssemblyName Condition="'$(RuntimeIdentifier)' != '' And $(RuntimeIdentifier.StartsWith('win'))">elasticlm</AssemblyName>
    <AssemblyName Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">elasticlm</AssemblyName>
    <AssemblyName Condition="'$(AssemblyName)' != 'elasticlm'">libelasticlm</AssemblyName>
    <RootNamespace>ElasticLM.Native</RootNamespace>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ElasticLM.Licensing\ElasticLM.Licensing.csproj" />
    <ProjectReference Include="..\ElasticLM.Client\ElasticLM.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests replace the verifier's clock with a fake one (design §17.4). -->
    <InternalsVisibleTo Include="ElasticLM.Native.Tests" />
  </ItemGroup>

  <!-- design §17.4: elm_version returns a constant written at build time, not an attribute read by reflection. -->
  <Target Name="ElmWriteNativeVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_ElmNativeVersionFile>$(IntermediateOutputPath)NativeVersion.g.cs</_ElmNativeVersionFile>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(_ElmNativeVersionFile)"
      Lines="// Generated by ElasticLM.Native.csproj.;namespace ElasticLM.Native%3B;internal static class NativeVersion { public const string Text = &quot;$(Version)&quot;%3B }"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"
    />
    <ItemGroup>
      <Compile Include="$(_ElmNativeVersionFile)" />
      <FileWrites Include="$(_ElmNativeVersionFile)" />
    </ItemGroup>
  </Target>
</Project>
