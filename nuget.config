<?xml version="1.0" encoding="utf-8"?>
<!-- design §5.3 (T25), §20.5: every restore in this repository takes its packages from nuget.org only. The machine's and
     the user's sources are cleared, so a second source on a build machine cannot serve a pinned ID and version. The key
     is the same as in samples/PackageConsumer/nuget.config, whose own mapping takes ElasticLM.* from the local packages. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
