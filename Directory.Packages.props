<Project>
  <!-- Central Package Management. A new dependency is checked against .cursor/rules/dependencies.mdc first. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Analyzers">
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
  <ItemGroup Label="Cli">
    <!-- elm only. NativeAOT: 0 warnings, +1.9 MB (Issue #11). design §21. -->
    <PackageVersion Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>
  <ItemGroup Label="Service">
    <!-- elm-service only (design §14.2, §21). SQLite itself is built from vendor/sqlite; the provider binds to it by name. -->
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.14" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="2.1.13" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- elm-service only: the type-checked SQL builder (design §14.2, decision 0.81). MIT, no runtime dependency, NativeAOT. -->
    <PackageVersion Include="AuraORM" Version="0.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="Server">
    <!-- elm-server only: runs under the Windows service control manager (design §13.1, V1d29a; §21). MIT. NativeAOT: 0 warnings. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="Tools">
    <!-- tools/ElasticLM.ActionPins only: reads the workflows as YAML (design §20.5, V1d22; §21). MIT, no dependency. -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <!-- ElasticLM.Licensing.Tests only: parses the string literals of src/ (design §20.7, V1c6; §21). MIT. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
  </ItemGroup>
</Project>
